def _prep_for_ocr(img):
    """Upscale + grayscale + threshold a frame for sharper on-screen-text OCR."""
    from PIL import Image
    import numpy as np
    if img.width < 1000:
        scale = 1000 / img.width
        img = img.resize((int(img.width * scale), int(img.height * scale)), Image.LANCZOS)
    gray = np.asarray(img.convert("L"))
    thresh = gray.mean()
    bw = (gray > thresh).astype("uint8") * 255
    return Image.fromarray(bw)


# ---------------------------------------------------------------------------
# 5. OCR each kept frame (optional; financial numbers shown on screen)
# ---------------------------------------------------------------------------
def ocr_frames(frames, frames_dir, tuned=False):
    import pytesseract
    from PIL import Image
    ocr_dir = frames_dir / "ocr"
    ocr_dir.mkdir(exist_ok=True)
    combined = []
    ocr_map = {}
    for path, t in frames:
        im = Image.open(path)
        if tuned:
            im = _prep_for_ocr(im)
            text = pytesseract.image_to_string(im, config="--psm 6").strip()
        else:
            text = pytesseract.image_to_string(im).strip()
        ocr_map[path] = text
        (ocr_dir / (path.stem + ".txt")).write_text(text, encoding="utf-8")
        if text:
            combined.append(f"### {path.name} (@ {hms(t)})\n{text}\n")
    (frames_dir / "ocr-combined.md").write_text(
        "\n".join(combined) + "\n", encoding="utf-8"
    )
    return ocr_map


# ---------------------------------------------------------------------------
# 6. contact sheet montage (overview)
# ---------------------------------------------------------------------------
def contact_sheet(frames, out_path, cols=4, thumb_w=480):
    from PIL import Image, ImageDraw
    if not frames:
        return None
    thumbs = []
    for path, t in frames:
        im = Image.open(path).convert("RGB")
        ratio = thumb_w / im.width
        im = im.resize((thumb_w, int(im.height * ratio)))
        d = ImageDraw.Draw(im)
        label = hms(t)
        d.rectangle([0, 0, 8 + 8 * len(label), 18], fill=(0, 0, 0))
        d.text((4, 3), label, fill=(255, 255, 255))
        thumbs.append(im)
    rows = (len(thumbs) + cols - 1) // cols
    cell_h = max(t.height for t in thumbs)
    sheet = Image.new("RGB", (cols * thumb_w, rows * cell_h), (20, 20, 20))
    for i, im in enumerate(thumbs):
        sheet.paste(im, ((i % cols) * thumb_w, (i // cols) * cell_h))
    sheet.save(out_path, quality=85)
    return out_path


def write_timeline(out_dir, kept, segments, ocr_map):
    """Chronological merge of frames + transcript + OCR. Tolerates missing inputs."""
    lines = ["# Timeline\n"]
    n = len(kept)
    for i, (path, t) in enumerate(kept):
        next_t = kept[i + 1][1] if i + 1 < n else float("inf")
        lines.append(f"## {hms(t)}")
        lines.append(f"![frame](frames/{path.name})")
        for s, said in segments:
            if t <= s < next_t:
                lines.append(f"> {said}")
        snippet = " ".join((ocr_map.get(path, "") or "").split())[:200]
        if snippet:
            lines.append(f"OCR: {snippet}")
        lines.append("")
    (out_dir / "timeline.md").write_text("\n".join(lines) + "\n", encoding="utf-8")


def reconcile_stale(out_dir, frames_dir, dir_was_ours, do_transcribe, do_timeline, do_contact):
    """Remove prior watch-video artifacts this run will NOT (re)produce, so SUMMARY stays accurate.
    Acts ONLY when the folder was already a watch-video output before this run (dir_was_ours) --
    so it never touches a user's pre-existing non-watch-video folder."""
    if not dir_was_ours:
        return
    (out_dir / "metadata.md").unlink(missing_ok=True)
    (out_dir / "metadata.json").unlink(missing_ok=True)
    captions_dir = out_dir / "captions"
    if captions_dir.exists():
        for f in captions_dir.glob("source*"):
            if f.is_file():
                f.unlink(missing_ok=True)
    if not do_transcribe:
        (out_dir / "transcript.md").unlink(missing_ok=True)
        (out_dir / "transcript.txt").unlink(missing_ok=True)
    if not do_timeline:
        (out_dir / "timeline.md").unlink(missing_ok=True)
    if not do_contact:
        (out_dir / "contact-sheet.jpg").unlink(missing_ok=True)
    # OCR outputs are stale every re-run (frames are re-extracted) -- always clear them; they are
    # regenerated this run if OCR runs. This also fixes lingering per-frame files when OCR stays on.
    (frames_dir / "ocr-combined.md").unlink(missing_ok=True)
    ocr_dir = frames_dir / "ocr"
    if ocr_dir.exists():
        for f in ocr_dir.glob("*.txt"):
            f.unlink(missing_ok=True)
    # frames are always re-extracted fresh -- clear watch-video's OWN frame-name patterns only
    # (extraction temps "NNNNNN.jpg" + deduped "frame_*.jpg"), never a user's unrelated .jpg.
    if frames_dir.exists():
        for pattern in ("frame_*.jpg", "[0-9][0-9][0-9][0-9][0-9][0-9].jpg"):
            for f in frames_dir.glob(pattern):
                f.unlink(missing_ok=True)


def manifest_created(path):
    try:
        data = json.loads((Path(path) / ".watch-video.json").read_text(encoding="utf-8"))
        return datetime.fromisoformat(data["created"])
    except Exception:
        return None


def _looks_like_path(arg):
    return ("/" in arg) or ("\\" in arg) or Path(arg).is_absolute()


VIDEO_SUFFIXES = {
    ".avi", ".flv", ".m4v", ".mkv", ".mov", ".mp4",
    ".mpeg", ".mpg", ".webm", ".wmv",
}


def validate_processing_args(parser, args):
    """Reject invalid inputs before starting expensive or destructive work."""
    if args.periodic <= 0:
        parser.error("--periodic SECONDS must be > 0")
    if not 0 <= args.scene_threshold <= 1:
        parser.error("--scene-threshold must be between 0 and 1")
    if args.max_frames < 1:
        parser.error("--max-frames must be >= 1")
    if args.dedupe_distance < 0:
        parser.error("--dedupe-distance must be >= 0")
    if args.cookies and not Path(args.cookies).expanduser().is_file():
        parser.error("--cookies FILE does not exist or is not a file")
    source_path = Path(args.source).expanduser()
    try:
        parsed = urlsplit(args.source)
        is_remote = parsed.scheme in ("http", "https") and bool(parsed.netloc)
    except ValueError:
        is_remote = False
    looks_local = not is_remote and (
        _looks_like_path(args.source) or source_path.suffix.lower() in VIDEO_SUFFIXES
    )
    if looks_local and not source_path.is_file():
        parser.error(f"local source file not found: {args.source}")


# The exact set of files/dirs watch-video creates in an output folder.
WV_ARTIFACT_NAMES = ("SUMMARY.md", "transcript.md", "transcript.txt", "timeline.md",
                     "contact-sheet.jpg", "metadata.md", "metadata.json", ".watch-video.json")


def remove_wv_artifacts(d):
    """Delete ONLY watch-video's own artifacts in d, then rmdir d if it is now empty.
    Never blanket-deletes the folder: if the user pointed --out at a folder containing
    their own files, those survive and the folder is left in place."""
    d = Path(d)
    downloaded = None
    try:
        m = json.loads((d / ".watch-video.json").read_text(encoding="utf-8"))
        if m.get("tool") == "watch-video":
            downloaded = m.get("downloaded_source")
    except Exception:
        downloaded = None
    for name in WV_ARTIFACT_NAMES:
        (d / name).unlink(missing_ok=True)
    if downloaded:
        cand = d / Path(downloaded).name           # basename only — never escape d via ../ or abs path
        if cand.parent.resolve() == d.resolve():
            cand.unlink(missing_ok=True)
    frames = d / "frames"
    if frames.exists():
        (frames / "ocr-combined.md").unlink(missing_ok=True)
        (frames / "_showinfo.txt").unlink(missing_ok=True)
        ocr_dir = frames / "ocr"
        if ocr_dir.exists():
            for f in ocr_dir.glob("*.txt"):
                f.unlink(missing_ok=True)
            try:
                ocr_dir.rmdir()
            except OSError:
                pass
        for pattern in ("frame_*.jpg", "[0-9][0-9][0-9][0-9][0-9][0-9].jpg"):
            for f in frames.glob(pattern):
                f.unlink(missing_ok=True)
        try:
            frames.rmdir()   # remove frames/ only if now empty — user's own files survive
        except OSError:
            pass
    captions = d / "captions"
    if captions.exists():
        for f in captions.glob("source*"):
            if f.is_file():
                f.unlink(missing_ok=True)
        try:
            captions.rmdir()
        except OSError:
            pass
    try:
        d.rmdir()                      # removes the folder ONLY if nothing else remains
        return True
    except OSError:
        eprint(f"[clean] {d}: removed watch-video artifacts; folder kept (contains other files)")
        return False


def do_clean(clean_arg, older_than, base):
    targets, skipped = [], []
    if older_than is not None:
        cutoff = datetime.now(timezone.utc) - timedelta(days=older_than)
        if base.exists():
            for d in sorted(p for p in base.iterdir() if p.is_dir()):
                created = manifest_created(d)
                if is_watch_video_dir(d) and created is not None and created < cutoff:
                    targets.append(d)
                else:
                    skipped.append(d)
    elif clean_arg == "all":
        if base.exists():
            for d in sorted(p for p in base.iterdir() if p.is_dir()):
                (targets if is_watch_video_dir(d) else skipped).append(d)
    elif clean_arg and _looks_like_path(clean_arg):
        d = Path(clean_arg).expanduser()
        (targets if is_watch_video_dir(d) else skipped).append(d)
    elif clean_arg:  # bare token -> slug under base
        d = base / clean_arg
        (targets if is_watch_video_dir(d) else skipped).append(d)
    for d in targets:
        removed = remove_wv_artifacts(d)
        eprint(f"[clean] {'deleted' if removed else 'cleaned (folder kept)'} {d}")
    for d in skipped:
        eprint(f"[clean] skipped (no valid watch-video manifest) {d}")
    return targets, skipped


def prune_source(video, was_downloaded):
    """Delete the source video ONLY if watch-video downloaded it. Never deletes a
    user-provided local input. Returns True if it deleted something."""
    if not was_downloaded:
        return False
    try:
        Path(video).unlink(missing_ok=True)
        eprint(f"[no-source] removed downloaded source {video}")
        return True
    except Exception as e:
        eprint(f"[no-source] could not remove source: {e}")
        return False


# ---------------------------------------------------------------------------
def main():
    p = argparse.ArgumentParser(prog="watch-video", description="Video → transcript + key frames for an LLM.")
    p.add_argument("source", nargs="?", help="Loom/any URL, or a local video file")
    p.add_argument("--diagnose", action="store_true",
                   help="report dependencies and CUDA visibility, then exit")
    p.add_argument("--clean", metavar="SLUG|PATH|all",
                   help="janitorial: delete a watch-video output folder and exit")
    p.add_argument("--clean-older-than", type=int, metavar="DAYS",
                   help="janitorial: delete watch-video folders older than DAYS and exit")
    p.add_argument("--out")
    p.add_argument("--model", default="auto",
                   help="Whisper model, or auto = medium on CUDA / small on CPU")
    p.add_argument("--device", choices=("auto", "cuda", "cpu"), default="auto",
                   help="Whisper device (default: auto, prefers CUDA when visible)")
    p.add_argument("--compute-type", default="auto",
                   help="Whisper compute type (default: float16 on CUDA, int8 on CPU)")
    p.add_argument("--periodic", type=float, default=4)
    p.add_argument("--scene-threshold", type=float, default=0.08)
    p.add_argument("--max-frames", type=int, default=200)
    p.add_argument("--dedupe-distance", type=int, default=6)
    p.add_argument("--no-ocr", action="store_true")
    p.add_argument("--no-contact-sheet", action="store_true")
    p.add_argument("--no-timeline", action="store_true")
    p.add_argument("--no-source", action="store_true")
    p.add_argument("--ocr-tuned", action="store_true")
    p.add_argument("--force", action="store_true",
                   help="allow writing into a non-empty directory not created by watch-video")
    p.add_argument("--cookies-from-browser")
    p.add_argument("--cookies")
    p.add_argument("--language")
    p.add_argument("--caption-language", default="auto",
                   help="preferred caption language; default uses declared language, then ja/en")
    p.add_argument("--captions", metavar="VTT|SRT",
                   help="explicit local caption file to use before Whisper")
    p.add_argument("--no-captions", action="store_true",
                   help="skip embedded/sidecar caption discovery and use Whisper")
    p.add_argument("--captions-only", action="store_true",
                   help="never fall back to Whisper when no usable caption is available")
    p.add_argument("--no-transcribe", action="store_true")
    args = p.parse_args()

    if args.diagnose:
        diagnose()
        return
    if args.captions and args.no_captions:
        p.error("--captions and --no-captions are mutually exclusive")
    if args.captions_only and args.no_transcribe:
        p.error("--captions-only and --no-transcribe are mutually exclusive")

    if args.clean is not None and args.clean_older_than is not None:
        p.error("--clean and --clean-older-than are mutually exclusive")
    if args.clean_older_than is not None and args.clean_older_than < 0:
        p.error("--clean-older-than DAYS must be >= 0")
    if args.clean is not None or args.clean_older_than is not None:
        base = Path.cwd() / "watch-video-out"
        do_clean(args.clean, args.clean_older_than, base)
        return
    if not args.source:
        p.error("source is required unless --clean/--clean-older-than is given")
    validate_processing_args(p, args)

    missing_media_tools = [name for name in ("ffmpeg", "ffprobe") if not have(name)]
    if missing_media_tools:
        sys.exit(
            "ERROR: required media tool(s) missing: "
            f"{', '.join(missing_media_tools)}. Install ffmpeg via scripts/setup.py, "
            "or brew/apt/dnf/winget."
        )

    out_dir = Path(args.out).expanduser() if args.out else Path.cwd() / "watch-video-out" / slugify(args.source)
    # Determine ownership + emptiness BEFORE we create/write anything, so we never clobber
    # or later --clean a user's pre-existing directory that we don't own.
    dir_was_ours = is_watch_video_dir(out_dir)   # validates the manifest signature, not just presence
    if out_dir.exists() and any(out_dir.iterdir()) and not dir_was_ours and not args.force:
        sys.exit(
            f"ERROR: --out '{out_dir}' is a non-empty directory not created by watch-video.\n"
            "Refusing to write frames/transcript/etc. into it (a later --clean could remove your\n"
            "files). Choose a new/empty --out, or pass --force to override."
        )
    previous_downloaded = None
    if dir_was_ours:
        try:
            previous_downloaded = json.loads(
                (out_dir / ".watch-video.json").read_text(encoding="utf-8")
            ).get("downloaded_source")
        except Exception:
            previous_downloaded = None
    out_dir.mkdir(parents=True, exist_ok=True)
    # Claim a newly validated empty directory before network work. Existing owned dirs
    # retain their prior download marker until acquisition succeeds, which makes retries
    # and replacement of a prior tool-owned source safe.
    if not dir_was_ours:
        write_manifest(out_dir, args.source)
    frames_dir = out_dir / "frames"
    eprint(f"[watch-video] output → {out_dir}")

    do_transcribe = not args.no_transcribe
    do_timeline_planned = not args.no_timeline
    do_contact_planned = not args.no_contact_sheet
    frames_dir.mkdir(parents=True, exist_ok=True)
    reconcile_stale(out_dir, frames_dir, dir_was_ours, do_transcribe,
                    do_timeline_planned, do_contact_planned)

    info = probe_source(args.source, args.cookies_from_browser, args.cookies)
    metadata = write_metadata(out_dir, info, args.source)
    caption = None
    if do_transcribe and not args.no_captions:
        caption = find_local_caption(args.source, args.captions, args.caption_language)
        if caption is None and info and not Path(args.source).expanduser().is_file():
            caption = download_caption(
                args.source, out_dir, info, args.caption_language,
                args.cookies_from_browser, args.cookies,
            )

    video, was_downloaded = acquire(args.source, out_dir, args.cookies_from_browser, args.cookies)
    if not was_downloaded and previous_downloaded:
        old_source = out_dir / Path(previous_downloaded).name
        try:
            same_as_input = old_source.resolve() == Path(video).resolve()
        except OSError:
            same_as_input = False
        if not same_as_input:
            old_source.unlink(missing_ok=True)
    write_manifest(out_dir, args.source, Path(video).name if was_downloaded else None)
    dur = duration_seconds(video)

    eprint("[frames] extracting (first + scene-change + periodic)…")
    raw = extract_frames(video, frames_dir, args.periodic, args.scene_threshold)
    kept = dedupe(raw, args.dedupe_distance, args.max_frames)
    eprint(f"[frames] {len(raw)} extracted → {len(kept)} kept after dedupe")

    if args.no_transcribe:
        lang, segments = "skipped", []
        transcript_source, backend = "none", "none"
        eprint("[transcribe] skipped (--no-transcribe)")
    else:
        caption_segments = write_caption_transcript(out_dir, caption) if caption else None
        if caption_segments:
            lang, segments = caption["language"], caption_segments
            transcript_source = caption["kind"]
            backend = "caption"
            eprint(f"[transcribe] using {transcript_source} ({len(segments)} cues); Whisper skipped.")
        elif args.captions_only:
            lang, segments = "unavailable", []
            transcript_source, backend = "none (captions-only)", "none"
            eprint("[transcribe] no usable captions; Whisper skipped (--captions-only).")
        else:
            lang, segments, actual_device, actual_compute, actual_model = transcribe(
                video, out_dir, args.model, args.language, args.device, args.compute_type
            )
            transcript_source = "local-whisper"
            backend = f"{actual_device}/{actual_compute}, model={actual_model}"
    n_seg = len(segments)

    do_ocr = (not args.no_ocr) and have("tesseract")
    if not args.no_ocr and not have("tesseract"):
        eprint("[ocr] tesseract not found — skipping OCR (install via scripts/setup.py, or brew/apt/dnf/winget).")
    ocr_map = {}
    if do_ocr:
        eprint(f"[ocr] reading on-screen text from {len(kept)} frames…")
        try:
            ocr_map = ocr_frames(kept, frames_dir, tuned=args.ocr_tuned)
        except Exception as exc:
            do_ocr = False
            eprint(f"[ocr] WARNING: OCR failed and was skipped: {safe_error_message(exc)}")

    sheet = None
    if not args.no_contact_sheet:
        sheet = contact_sheet(kept, out_dir / "contact-sheet.jpg")

    do_timeline = not args.no_timeline
    if do_timeline:
        write_timeline(out_dir, kept, segments, ocr_map)

    # SUMMARY.md — the entry point an agent reads first
    lines = [
        f"# watch-video result — {slugify(args.source)}",
        "",
        f"- **Source:** `{safe_source(args.source)}`",
        f"- **Platform / extractor:** `{metadata.get('extractor', 'unknown')}`",
        f"- **Title:** {metadata.get('title', 'unknown')}",
        f"- **Duration:** {hms(dur)}",
        f"- **Frames kept:** {len(kept)} (deduped from {len(raw)})",
        f"- **Transcript:** {n_seg} segments, language `{lang}`, source `{transcript_source}`",
        f"- **Transcription backend:** `{backend}`",
        f"- **OCR:** {'yes → frames/ocr-combined.md' if do_ocr else 'no'}",
        f"- **Contact sheet:** {'contact-sheet.jpg' if sheet else 'none'}",
        f"- **Timeline:** {'yes → timeline.md' if do_timeline else 'no'}",
        "",
        "## How to read this (for an LLM/agent)",
        "0. Read this SUMMARY, then read the files it lists below (skip any not present).",
        "1. `metadata.md` contains title/post text/uploader/date/chapters from the source platform.",
        "2. `timeline.md` interleaves each frame with what was said + on-screen text — read this first.",
        "3. `transcript.md` for the full timestamped transcript and its provenance.",
        "4. Open individual `frames/*.jpg`; cross-check exact numbers against `frames/ocr-combined.md`"
        " (OCR can misread; the image is ground truth).",
        "",
        "> ⚠️ This folder may contain private/financial client data — do not commit it.",
        "",
        "## Frames",
    ]
    for path, t in kept:
        lines.append(f"- `frames/{path.name}` @ {hms(t)}")
    (out_dir / "SUMMARY.md").write_text("\n".join(lines) + "\n", encoding="utf-8")

    if args.no_source:
        prune_source(video, was_downloaded)

    eprint(f"\n[done] {out_dir}/SUMMARY.md")
    print(str(out_dir / "SUMMARY.md"))


def cli_entrypoint():
    configure_stdio()
    try:
        main()
    except KeyboardInterrupt:
        eprint("ERROR: cancelled by user")
        raise SystemExit(130)
    except WatchVideoError as exc:
        eprint(f"ERROR: {safe_error_message(exc)}")
        raise SystemExit(1)
    except subprocess.CalledProcessError as exc:
        command = Path(str(exc.cmd[0] if isinstance(exc.cmd, (list, tuple)) else exc.cmd)).name
        eprint(f"ERROR: {command or 'external command'} failed (exit {exc.returncode})")
        raise SystemExit(exc.returncode or 1)
    except Exception as exc:
        if os.environ.get("WATCH_VIDEO_DEBUG") == "1":
            traceback.print_exc()
        else:
            eprint(
                f"ERROR: unexpected {type(exc).__name__}: {safe_error_message(exc)} "
                "(set WATCH_VIDEO_DEBUG=1 for a traceback)"
            )
        raise SystemExit(1)


if __name__ == "__main__":
    cli_entrypoint()

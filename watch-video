#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.10"
# dependencies = [
#   "faster-whisper>=1.1.0",
#   "onnxruntime==1.19.2; python_version < '3.11'",
#   "yt-dlp[default,curl-cffi]>=2026.8.6",
#   "Pillow>=10.0",
#   "numpy>=1.24",
#   "pytesseract>=0.3.10",
# ]
# ///
"""
watch-video — turn a video (Loom / URL / local file) into something an LLM can read:
a timestamped transcript + a deduplicated set of key frames (+ optional OCR of
on-screen text). Built so a CLI coding agent (Claude Code, etc.) can "watch" a
client's screen-recording and decipher it.

Everything runs LOCALLY (yt-dlp + ffmpeg + faster-whisper + tesseract). No video or
audio is sent to a cloud service — important when the recording contains private /
financial data. The only thing that leaves your machine is whatever you (or your
agent) later choose to read out of the output folder.

Usage:
    watch-video <loom-url | any-url | local-file> [options]

Common options:
    --out DIR                 output folder (default: ./watch-video-out/<slug>)
    --model NAME              whisper model or auto (medium on CUDA, small on CPU)
    --periodic SECONDS        sample a frame every N seconds (default: 4)
    --scene-threshold FLOAT   extra frame on scene change, 0..1 (default: 0.08)
    --max-frames N            cap kept frames (default: 200)
    --dedupe-distance N       perceptual-hash hamming distance to treat frames as dupes (default: 6)
    --no-ocr                  skip the tesseract OCR pass
    --no-contact-sheet        skip the montage overview image
    --cookies-from-browser B  pass private/team Loom auth via browser cookies (firefox|chrome|...)
    --cookies FILE            pass a Netscape cookies.txt for yt-dlp
    --language LANG           force transcription language (e.g. en); default = auto-detect

Output folder contains: SUMMARY.md (read this first), transcript.md, transcript.txt,
frames/*.jpg, frames/ocr/*.txt (if OCR), contact-sheet.jpg.
"""

import argparse
import html
import json
import os
import platform
import re
import shutil
import subprocess
import sys
import tempfile
import traceback
from datetime import datetime, timedelta, timezone
from functools import lru_cache
from pathlib import Path
from urllib.parse import urlsplit, urlunsplit

WATCH_VIDEO_VERSION = "1.2.1"


def configure_stdio():
    """Use UTF-8 for paths and diagnostics even on legacy Windows consoles."""
    for stream in (sys.stdout, sys.stderr):
        reconfigure = getattr(stream, "reconfigure", None)
        if reconfigure is not None:
            try:
                reconfigure(encoding="utf-8", errors="replace")
            except (OSError, ValueError):
                # Redirected or already-detached streams may not be reconfigurable.
                pass


def safe_source(value):
    """Return a source identifier safe to persist or print.

    Remote URLs may contain signed query strings, access tokens, fragments, or HTTP
    userinfo. The raw value is still passed to yt-dlp, but it is never written to
    logs or output artifacts.
    """
    text = str(value)
    try:
        parts = urlsplit(text)
    except ValueError:
        return text
    if parts.scheme not in ("http", "https") or not parts.netloc:
        return text
    host = parts.hostname or ""
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"
    try:
        port = f":{parts.port}" if parts.port else ""
    except ValueError:
        port = ""
    query = "redacted" if parts.query else ""
    return urlunsplit((parts.scheme, f"{host}{port}", parts.path, query, ""))


def safe_error_message(exc):
    """Keep failures useful without echoing credentials embedded in URLs."""
    message = str(exc).strip() or type(exc).__name__
    return re.sub(r"https?://[^\s'\"<>]+", lambda m: safe_source(m.group(0)), message)


def write_manifest(out_dir, source, downloaded_name=None):
    """Write the hidden ownership marker every cleanup operation validates.
    Preserves an existing valid manifest's `created` so re-runs don't reset run age.
    Records `downloaded_source` (the basename watch-video downloaded) so cleanup deletes
    only OUR source file, never a user's pre-existing source.*."""
    mf = out_dir / ".watch-video.json"
    created = None
    if mf.is_file():
        try:
            old = json.loads(mf.read_text(encoding="utf-8"))
            if old.get("tool") == "watch-video":
                created = old.get("created")
        except Exception:
            created = None
    manifest = {
        "tool": "watch-video",
        "version": WATCH_VIDEO_VERSION,
        "source": safe_source(source),
        "downloaded_source": downloaded_name,
        "created": created or datetime.now(timezone.utc).isoformat(),
    }
    mf.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def is_watch_video_dir(path):
    """True only if path holds a .watch-video.json whose SIGNATURE validates — not mere
    filename presence. The single ownership gate used by reconciliation AND cleanup."""
    mf = Path(path) / ".watch-video.json"
    if not mf.is_file():
        return False
    try:
        return json.loads(mf.read_text(encoding="utf-8")).get("tool") == "watch-video"
    except Exception:
        return False


def eprint(*a):
    print(*a, file=sys.stderr, flush=True)


class WatchVideoError(RuntimeError):
    """Expected operational failure that should be shown without a traceback."""


def run(cmd, label="external command"):
    """Run a network-facing command without streaming credential-bearing URLs."""
    try:
        proc = subprocess.run(
            cmd, capture_output=True, text=True, encoding="utf-8", errors="replace"
        )
    except OSError as exc:
        raise WatchVideoError(f"{label} could not start: {safe_error_message(exc)}") from exc
    if proc.returncode:
        lines = (proc.stderr or proc.stdout or "").strip().splitlines()
        detail = safe_error_message(lines[-1]) if lines else "no diagnostic output"
        raise WatchVideoError(f"{label} failed (exit {proc.returncode}): {detail}")
    return proc


def have(binary):
    return shutil.which(binary) is not None


@lru_cache(maxsize=1)
def fps_mode_args():
    """Ask this ffmpeg which frame-rate flag it takes, rather than guessing from a version string.

    ffmpeg 9 REMOVED `-vsync` ("Unrecognized option 'vsync'"), and `-fps_mode` only arrived in
    5.1 - so neither flag alone covers the builds in the wild, and distro version strings
    ("n5.1.2", "4.4.2-0ubuntu0.22.04.1") are not worth parsing. One throwaway encode of a null
    source settles it.
    """
    probe = subprocess.run(
        ["ffmpeg", "-hide_banner", "-loglevel", "error",
         "-f", "lavfi", "-i", "nullsrc=s=16x16:d=0.04",
         "-fps_mode", "vfr", "-f", "null", "-"],
        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
    )
    return ["-fps_mode", "vfr"] if probe.returncode == 0 else ["-vsync", "vfr"]


def slugify(text):
    # Slugs are written to directory names and SUMMARY headings, so sanitize
    # credential-bearing URLs before deriving them just like other persisted output.
    text = safe_source(text)
    text = re.sub(r"^https?://", "", text)
    text = re.sub(r"[^a-zA-Z0-9._-]+", "-", text).strip("-")
    return (text[:60] or "video").lower()


def hms(seconds):
    seconds = int(seconds)
    h, rem = divmod(seconds, 3600)
    m, s = divmod(rem, 60)
    return f"{h:d}:{m:02d}:{s:02d}" if h else f"{m:d}:{s:02d}"


# ---------------------------------------------------------------------------
# 1. acquire the video (local file passthrough, else yt-dlp)
# ---------------------------------------------------------------------------
def acquire(source, out_dir, cookies_from_browser, cookies_file):
    local = Path(source).expanduser()
    if local.exists() and local.is_file():
        eprint(f"[acquire] local file: {local}")
        return local, False

    if not have("yt-dlp"):
        sys.exit("ERROR: yt-dlp not found. Install with: uv tool install yt-dlp")

    # Download in a private temporary directory. This prevents failed/partial downloads
    # from poisoning a retry and avoids overwriting a user's source.mp4 under --force.
    with tempfile.TemporaryDirectory(prefix=".watch-video-download-", dir=out_dir) as tmp:
        tmp_dir = Path(tmp)
        target = tmp_dir / "download.%(ext)s"
        cmd = [
            "yt-dlp",
            "--no-playlist",
            "-f", "bv*+ba/b",            # best video+audio, merged by ffmpeg
            "--merge-output-format", "mp4",
            "-o", str(target),
        ]
        if cookies_from_browser:
            cmd += ["--cookies-from-browser", cookies_from_browser]
        if cookies_file:
            cmd += ["--cookies", str(Path(cookies_file).expanduser())]
        cmd.append(source)
        eprint(f"[acquire] downloading via yt-dlp: {safe_source(source)}")
        run(cmd, "yt-dlp media download")
        downloads = sorted(path for path in tmp_dir.glob("download.*") if path.is_file())
        if not downloads:
            raise WatchVideoError(
                "yt-dlp produced no media file (a private link may need "
                "--cookies-from-browser)"
            )
        downloaded = downloads[0]
        previous = None
        try:
            manifest = json.loads(
                (out_dir / ".watch-video.json").read_text(encoding="utf-8")
            )
            previous_name = manifest.get("downloaded_source")
            if manifest.get("tool") == "watch-video" and previous_name:
                previous = out_dir / Path(previous_name).name
        except Exception:
            previous = None
        preferred = out_dir / f"source{downloaded.suffix.lower()}"
        if previous and previous.suffix.lower() == downloaded.suffix.lower():
            destination = previous
        else:
            destination = preferred
            counter = 1
            while destination.exists():
                destination = out_dir / (
                    f"source-watch-video-{counter}{downloaded.suffix.lower()}"
                )
                counter += 1
        if previous == destination:
            destination.unlink(missing_ok=True)
        shutil.move(str(downloaded), str(destination))
        if previous and previous != destination:
            previous.unlink(missing_ok=True)
        return destination, True


def _auth_args(cookies_from_browser, cookies_file):
    args = []
    # yt-dlp enables Deno automatically, but other installed runtimes must be named.
    # This keeps current YouTube extraction working on machines that have Node but not Deno.
    if not have("deno"):
        for runtime, binary in (("node", "node"), ("bun", "bun"), ("quickjs", "qjs")):
            path = shutil.which(binary)
            if path:
                args += ["--js-runtimes", f"{runtime}:{path}"]
                break
    if cookies_from_browser:
        args += ["--cookies-from-browser", cookies_from_browser]
    if cookies_file:
        args += ["--cookies", str(Path(cookies_file).expanduser())]
    return args


def probe_source(source, cookies_from_browser=None, cookies_file=None):
    """Fetch public post/video metadata before the media download.

    This is deliberately best-effort: an extractor may allow the media download even
    when its JSON probe is incomplete. Only a small, stable subset is persisted so the
    output does not inherit yt-dlp's cookies, request headers, or volatile internals.
    """
    local = Path(source).expanduser()
    if local.exists() and local.is_file():
        stat = local.stat()
        return {
            "extractor": "local-file",
            "title": local.name,
            "webpage_url": None,
            "duration": duration_seconds(local),
            "filesize": stat.st_size,
        }
    if not have("yt-dlp"):
        return {}
    cmd = ["yt-dlp", "--no-playlist", "--skip-download", "--dump-single-json"]
    cmd += _auth_args(cookies_from_browser, cookies_file)
    cmd.append(source)
    eprint(f"[metadata] probing source via yt-dlp: {safe_source(source)}")
    proc = subprocess.run(
        cmd, capture_output=True, text=True, encoding="utf-8", errors="replace"
    )
    if proc.returncode != 0:
        tail = (proc.stderr or "").strip().splitlines()
        detail = safe_error_message(tail[-1]) if tail else "unknown error"
        eprint(f"[metadata] WARNING: probe failed: {detail}")
        return {}
    try:
        return json.loads(proc.stdout)
    except Exception as exc:
        eprint(f"[metadata] WARNING: could not parse yt-dlp metadata: {exc}")
        return {}


METADATA_KEYS = (
    "id", "title", "description", "extractor", "extractor_key", "webpage_url",
    "original_url", "uploader", "uploader_id", "channel", "channel_id", "creator",
    "duration", "timestamp", "release_timestamp", "upload_date", "live_status",
    "view_count", "like_count", "repost_count", "comment_count", "language",
    "availability", "age_limit", "categories", "tags", "chapters", "filesize",
)


def write_metadata(out_dir, info, source):
    """Write sanitized SNS/video context for the agent; never persist raw extractor JSON."""
    clean = {k: info.get(k) for k in METADATA_KEYS if info.get(k) is not None}
    for key in ("webpage_url", "original_url"):
        if key in clean:
            clean[key] = safe_source(clean[key])
    clean["source_input"] = safe_source(source)
    (out_dir / "metadata.json").write_text(
        json.dumps(clean, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    lines = ["# Source metadata", ""]
    labels = (
        ("title", "Title"), ("extractor", "Platform / extractor"),
        ("uploader", "Uploader"), ("channel", "Channel"), ("creator", "Creator"),
        ("webpage_url", "Canonical URL"), ("upload_date", "Upload date"),
        ("duration", "Duration (seconds)"), ("view_count", "Views"),
        ("like_count", "Likes"), ("repost_count", "Reposts"),
        ("comment_count", "Comments"), ("language", "Declared language"),
    )
    for key, label in labels:
        if clean.get(key) is not None:
            lines.append(f"- **{label}:** {clean[key]}")
    if clean.get("description"):
        lines += ["", "## Description / post text", "", str(clean["description"]).strip()]
    chapters = clean.get("chapters") or []
    if chapters:
        lines += ["", "## Chapters", ""]
        for chapter in chapters:
            lines.append(f"- **[{hms(chapter.get('start_time', 0))}]** {chapter.get('title', '')}")
    (out_dir / "metadata.md").write_text("\n".join(lines) + "\n", encoding="utf-8")
    return clean


def _lang_matches(key, preferred):
    key_l = (key or "").lower().replace("_", "-")
    pref_l = (preferred or "").lower().replace("_", "-")
    return key_l == pref_l or key_l.startswith(pref_l + "-") or pref_l.startswith(key_l + "-")


def choose_caption(info, preferred_language=None):
    """Return (kind, language) with authored captions preferred over automatic ones."""
    manual = info.get("subtitles") or {}
    automatic = info.get("automatic_captions") or {}
    declared = info.get("language")
    preferences = []
    if preferred_language and preferred_language != "auto":
        preferences.append(preferred_language)
    elif declared:
        preferences.append(declared)
    preferences += ["ja", "en"]

    for pool_name, pool in (("manual-caption", manual), ("auto-caption", automatic)):
        for pref in preferences:
            for key in pool:
                if _lang_matches(key, pref):
                    return pool_name, key
        if pool and not (preferred_language and preferred_language != "auto"):
            return pool_name, sorted(pool)[0]
    return None, None


def download_caption(source, out_dir, info, preferred_language, cookies_from_browser, cookies_file):
    kind, language = choose_caption(info, preferred_language)
    if not kind:
        return None
    captions_dir = out_dir / "captions"
    captions_dir.mkdir(exist_ok=True)
    cmd = [
        "yt-dlp", "--no-playlist", "--skip-download",
        "--write-subs" if kind == "manual-caption" else "--write-auto-subs",
        "--sub-langs", language, "--sub-format", "vtt/best", "--convert-subs", "vtt",
        "-o", str(captions_dir / "source"),
    ]
    cmd += _auth_args(cookies_from_browser, cookies_file)
    cmd.append(source)
    eprint(f"[captions] trying {kind} language '{language}' before Whisper…")
    proc = subprocess.run(
        cmd, capture_output=True, text=True, encoding="utf-8", errors="replace"
    )
    candidates = sorted(captions_dir.glob("source*.vtt"))
    if proc.returncode == 0 and candidates:
        return {"path": candidates[0], "kind": kind, "language": language}
    tail = (proc.stderr or proc.stdout or "").strip().splitlines()
    detail = f" ({safe_error_message(tail[-1])})" if tail else ""
    eprint(
        "[captions] selected caption could not be downloaded; "
        f"Whisper will be used if enabled.{detail}"
    )
    return None


def find_local_caption(source, explicit=None, preferred_language=None):
    video = Path(source).expanduser()
    candidates = []
    if explicit:
        candidates = [Path(explicit).expanduser()]
    elif video.exists() and video.is_file():
        if preferred_language and preferred_language != "auto":
            candidates += [video.with_suffix(f".{preferred_language}.vtt"),
                           video.with_suffix(f".{preferred_language}.srt")]
        candidates += [video.with_suffix(".vtt"), video.with_suffix(".srt")]
        candidates += sorted(video.parent.glob(video.stem + ".*.vtt"))
        candidates += sorted(video.parent.glob(video.stem + ".*.srt"))
    for candidate in candidates:
        if candidate.is_file():
            return {"path": candidate, "kind": "sidecar-caption",
                    "language": preferred_language if preferred_language != "auto" else "unknown"}
    if explicit:
        sys.exit(f"ERROR: caption file not found: {explicit}")
    return None


def _timestamp_seconds(value):
    parts = value.strip().replace(",", ".").split(":")
    try:
        if len(parts) == 3:
            return int(parts[0]) * 3600 + int(parts[1]) * 60 + float(parts[2])
        if len(parts) == 2:
            return int(parts[0]) * 60 + float(parts[1])
    except ValueError:
        pass
    raise ValueError(f"invalid caption timestamp: {value}")


def parse_caption(path):
    """Parse ordinary WebVTT/SRT cues into (start_seconds, text) pairs."""
    raw = Path(path).read_text(encoding="utf-8-sig", errors="replace")
    lines = raw.replace("\r\n", "\n").replace("\r", "\n").split("\n")
    raw_segments, i = [], 0
    timing = re.compile(r"^\s*([^ ]+)\s+-->\s+([^ ]+)")
    while i < len(lines):
        match = timing.match(lines[i])
        if not match:
            i += 1
            continue
        try:
            start = _timestamp_seconds(match.group(1))
        except ValueError:
            i += 1
            continue
        i += 1
        cue = []
        while i < len(lines) and lines[i].strip():
            cue.append(lines[i].strip())
            i += 1
        text = " ".join(cue)
        rolling = bool(re.search(r"<\d{1,2}:\d{2}(?::\d{2})?\.\d+>", text))
        text = html.unescape(re.sub(r"<[^>]+>", "", text))
        text = re.sub(r"\s+", " ", text).strip()
        if text:
            raw_segments.append((start, text, rolling))

    # YouTube's automatic WebVTT often emits karaoke-style rolling cues: each cue repeats
    # and extends the previous text. Collapse only cues carrying inline word timestamps;
    # ordinary authored VTT/SRT remains untouched.
    segments = []
    for start, text, rolling in raw_segments:
        if not segments:
            segments.append((start, text))
            continue
        prev_start, previous = segments[-1]
        if text == previous:
            continue
        if rolling and start - prev_start <= 8:
            if text.startswith(previous):
                segments[-1] = (prev_start, text)
                continue
            if previous.startswith(text):
                continue
            max_overlap = min(len(previous), len(text))
            overlap = next((n for n in range(max_overlap, 1, -1)
                            if previous[-n:] == text[:n]), 0)
            if overlap:
                text = text[overlap:].lstrip()
                if not text:
                    continue
        segments.append((start, text))
    return segments


def write_caption_transcript(out_dir, caption):
    source_path = Path(caption["path"])
    captions_dir = out_dir / "captions"
    captions_dir.mkdir(exist_ok=True)
    if source_path.parent.resolve() != captions_dir.resolve():
        copied = captions_dir / ("source" + source_path.suffix.lower())
        shutil.copy2(source_path, copied)
        source_path = copied
    segments = parse_caption(source_path)
    if not segments:
        eprint(f"[captions] WARNING: no usable cues in {source_path}; falling back to Whisper.")
        return None
    title = f"Caption transcript ({caption['kind']}, lang={caption['language']})"
    md = [f"# {title}", ""] + [f"- **[{hms(start)}]** {text}" for start, text in segments]
    (out_dir / "transcript.md").write_text("\n".join(md) + "\n", encoding="utf-8")
    (out_dir / "transcript.txt").write_text(
        "\n".join(text for _, text in segments) + "\n", encoding="utf-8"
    )
    return segments


# ---------------------------------------------------------------------------
# 2. probe duration
# ---------------------------------------------------------------------------
def duration_seconds(video):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "format=duration",
             "-of", "default=nw=1:nk=1", str(video)],
            check=True, capture_output=True, text=True,
        ).stdout.strip()
        return float(out)
    except Exception:
        return 0.0


# ---------------------------------------------------------------------------
# 3. extract frames: first + periodic + scene-change, then perceptual dedupe
# ---------------------------------------------------------------------------
def extract_frames(video, frames_dir, periodic, scene_threshold):
    frames_dir.mkdir(parents=True, exist_ok=True)
    select = (
        f"select='eq(n\\,0)+gt(scene\\,{scene_threshold})+not(mod(t\\,{periodic}))',"
        "showinfo"
    )
    info_log = frames_dir / "_showinfo.txt"
    with open(info_log, "w", encoding="utf-8") as log:
        try:
            subprocess.run(
                ["ffmpeg", "-hide_banner", "-loglevel", "info", "-i", str(video),
                 "-vf", select, *fps_mode_args(), "-q:v", "2",
                 str(frames_dir / "%06d.jpg")],
                check=True, stderr=log,
            )
        except subprocess.CalledProcessError as exc:
            log.flush()
            tail = info_log.read_text(encoding="utf-8", errors="replace").splitlines()
            detail = safe_error_message(tail[-1]) if tail else "no ffmpeg diagnostic output"
            raise WatchVideoError(
                f"frame extraction failed (ffmpeg exit {exc.returncode}): {detail}"
            ) from exc
    # map each emitted frame (in order) to its pts_time from showinfo
    times = [float(m) for m in re.findall(
        r"pts_time:([0-9.]+)", info_log.read_text(encoding="utf-8", errors="replace")
    )]
    info_log.unlink(missing_ok=True)
    frames = sorted(frames_dir.glob("[0-9]*.jpg"))
    if len(times) != len(frames):
        eprint(f"[frames] WARNING: showinfo emitted {len(times)} timestamps for {len(frames)} frames; extra frames get t=0.0")
    return list(zip(frames, times + [0.0] * (len(frames) - len(times))))


def dhash(path, size=8):
    from PIL import Image
    import numpy as np
    img = Image.open(path).convert("L").resize((size + 1, size), Image.LANCZOS)
    arr = np.asarray(img, dtype=np.int16)
    diff = arr[:, 1:] > arr[:, :-1]
    bits = 0
    for b in diff.flatten():
        bits = (bits << 1) | int(b)
    return bits


def hamming(a, b):
    return bin(a ^ b).count("1")


def dedupe(frame_times, distance, max_frames):
    kept, last_hash = [], None
    for path, t in frame_times:
        h = dhash(path)
        if last_hash is not None and hamming(h, last_hash) < distance:
            path.unlink(missing_ok=True)      # drop near-duplicate
            continue
        kept.append((path, t))
        last_hash = h
    # enforce cap by uniform thinning (keep first/last, sample the middle)
    if len(kept) > max_frames:
        if max_frames <= 1:
            idx = [0]
        else:
            idx = sorted({round(i * (len(kept) - 1) / (max_frames - 1)) for i in range(max_frames)})
        keepset = {kept[i][0] for i in idx}
        for path, _ in kept:
            if path not in keepset:
                path.unlink(missing_ok=True)
        kept = [(p, t) for p, t in kept if p in keepset]
    # renumber kept frames sequentially with their timestamp baked into the name
    renamed = []
    for i, (path, t) in enumerate(kept):
        new = path.with_name(f"frame_{i:03d}_{hms(t).replace(':', 'm')}s.jpg")
        path.rename(new)
        renamed.append((new, t))
    return renamed


# ---------------------------------------------------------------------------
# 4. transcribe with faster-whisper (local, CUDA when available)
# ---------------------------------------------------------------------------
def resolve_whisper_backend(device="auto", compute_type="auto"):
    requested = device
    if device == "auto":
        try:
            import ctranslate2
            device = "cuda" if ctranslate2.get_cuda_device_count() > 0 else "cpu"
        except Exception:
            device = "cpu"
    if compute_type == "auto":
        compute_type = "float16" if device == "cuda" else "int8"
    return requested, device, compute_type


def transcribe(video, out_dir, model_name, language, device="auto", compute_type="auto"):
    from faster_whisper import WhisperModel
    requested, actual_device, actual_compute = resolve_whisper_backend(device, compute_type)
    requested_model = model_name
    actual_model = ("medium" if actual_device == "cuda" else "small") if model_name == "auto" else model_name
    eprint(
        f"[transcribe] loading whisper '{actual_model}' "
        f"({actual_device}/{actual_compute}; first run downloads the model)…"
    )
    try:
        model = WhisperModel(actual_model, device=actual_device, compute_type=actual_compute)
        segment_iter, info = model.transcribe(str(video), language=language, vad_filter=True)
        raw_segments = list(segment_iter)  # CUDA/runtime failures can surface lazily here.
    except Exception as exc:
        if requested == "auto" and actual_device == "cuda":
            eprint(
                f"[transcribe] WARNING: CUDA failed ({safe_error_message(exc)}); "
                "retrying on CPU/int8."
            )
            actual_device, actual_compute = "cpu", "int8"
            if requested_model == "auto":
                actual_model = "small"
            try:
                model = WhisperModel(
                    actual_model, device=actual_device, compute_type=actual_compute
                )
                segment_iter, info = model.transcribe(
                    str(video), language=language, vad_filter=True
                )
                raw_segments = list(segment_iter)
            except Exception as fallback_exc:
                raise WatchVideoError(
                    "transcription failed after CUDA-to-CPU fallback: "
                    f"{safe_error_message(fallback_exc)}"
                ) from fallback_exc
        else:
            raise WatchVideoError(
                f"transcription failed on {actual_device}/{actual_compute}: "
                f"{safe_error_message(exc)}"
            ) from exc
    md, txt, segments_out = [], [], []
    for seg in raw_segments:
        stamp = hms(seg.start)
        line = seg.text.strip()
        md.append(f"- **[{stamp}]** {line}")
        txt.append(line)
        segments_out.append((seg.start, line))
    (out_dir / "transcript.md").write_text(
        f"# Transcript ({actual_model}, lang={info.language})\n\n" + "\n".join(md) + "\n",
        encoding="utf-8",
    )
    (out_dir / "transcript.txt").write_text("\n".join(txt) + "\n", encoding="utf-8")
    return info.language, segments_out, actual_device, actual_compute, actual_model


